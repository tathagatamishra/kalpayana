# Copy to .env.local for local dev, and add the same keys in
# Vercel → Settings → Environment Variables (Production + Preview).

# Standard Atlas SRV string (from Atlas → Connect → Drivers). Works on Vercel and
# most networks:
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"

# If you get "querySrv ECONNREFUSED" locally (VPN / corporate DNS that can't do SRV
# lookups), use the plain form instead — Atlas → Connect → Drivers → "Node.js 2.2.12
# or later" is SRV; pick an older version to get this host list, or expand the SRV
# record yourself. It resolves via the OS and avoids the SRV lookup:
# MONGODB_URI="mongodb://h1:27017,h2:27017,h3:27017/?replicaSet=atlas-xxxxx-shard-0&ssl=true&authSource=admin&retryWrites=true&w=majority"

MONGODB_DB="kalpayana"
ADMIN_PASSWORD="choose-a-strong-password"

# Optional: override Node's DNS resolvers if SRV lookups fail and you can't switch URIs.
# DNS_SERVERS="1.1.1.1,8.8.8.8"
